<% release = @transfer_request.request_type == 'release' %>
<% wording = PlayerWording.for(@transfer_request.player) %>
<h2><%= release ? 'Spielerfreigabe-Antrag' : 'Transferantrag' %> abgelehnt durch <%= wording.noun %></h2>

<p>Hallo,</p>

<p>
  der folgende <%= release ? 'Spielerfreigabe-Antrag' : 'Transferantrag' %> wurde <%= wording.by_agent %> abgelehnt und ist damit beendet.
</p>

<p>
  <strong><%= wording.noun %>:</strong> <%= @transfer_request.player.first_name %> <%= @transfer_request.player.last_name %><br>
  <strong>Abgebender Verein:</strong> <%= @transfer_request.former_club.name %><br>
  <strong>Aufnehmender Verein:</strong> <%= @transfer_request.requesting_club.name %>
</p>

<p>
  Das Saisonmanager-Team<br>
  <a href="<%= frontend_base_url %>"><%= frontend_host %></a>
</p>
