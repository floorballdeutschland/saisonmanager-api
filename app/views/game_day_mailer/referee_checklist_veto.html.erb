<p>Hallo,</p>

<p>
  Schiedsrichter*in <strong><%= @referee.vorname %> <%= @referee.nachname %></strong>
  hat den Spieltag <strong><%= @league_name %></strong> am
  <strong><%= @game_day.date %></strong>
  als <strong>nicht ordnungsgemäß durchgeführt</strong> gemeldet.
</p>

<% if @games.any? %>
  <p><%= if @games_matched
            @games.one? ? 'Spiel' : 'Spiele'
          else
            'Spiele des Spieltags (keinem Spiel direkt zuzuordnen)'
          end %>:</p>
  <ul>
    <% @games.each do |game| %>
      <li><%= GameDayMailer.game_label(game) %></li>
    <% end %>
  </ul>
<% end %>

<p>Antworten des Spieltagsberichts:</p>
<ul>
  <% @answers.each do |a| %>
    <li><%= a['question'] %>: <strong><%= a['answer'] ? 'Ja' : 'Nein' %></strong></li>
  <% end %>
</ul>

<% if @failed_items.any? %>
  <p>Mit „Nein" beantwortet (nicht erfüllt):</p>
  <ul>
    <% @failed_items.each do |a| %>
      <li><%= a['question'] %></li>
    <% end %>
  </ul>
<% end %>

<%# Erst h, dann simple_format: simple_format allein sanitisiert nur und lässt
    Tags wie <b> oder <a> durch. Die Anmerkung ist Freitext aus dem Portal und
    soll bei der SBK genau so ankommen, wie sie getippt wurde. %>
<% if @comment.present? %>
  <p>Anmerkung:</p>
  <blockquote><%= simple_format(h(@comment)) %></blockquote>
<% end %>

<p>Bitte prüfen.</p>
